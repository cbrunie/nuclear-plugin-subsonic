{
  "name": "nuclear-plugin-subsonic",
  "version": "0.1.0",
  "description": "Stream your Subsonic-compatible server (Navidrome, Gonic, Airsonic…) in Nuclear",
  "author": "cbrunie",
  "main": "src/index.ts",
  "type": "module",
  "nuclear": {
    "displayName": "Subsonic",
    "category": "streaming",
    "categories": [
      "metadata",
      "streaming"
    ],
    "permissions": [],
    "icon": {
      "type": "link",
      "link": "https://raw.githubusercontent.com/cbrunie/nuclear-plugin-subsonic/main/icon.png"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cbrunie/nuclear-plugin-subsonic.git"
  },
  "dependencies": {
    "@nuclearplayer/plugin-sdk": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "test": "node --test src/*.test.ts",
    "typecheck": "tsc --noEmit --strict --target es2022 --module esnext --moduleResolution bundler --skipLibCheck --lib es2022,dom src/index.ts"
  }
}
